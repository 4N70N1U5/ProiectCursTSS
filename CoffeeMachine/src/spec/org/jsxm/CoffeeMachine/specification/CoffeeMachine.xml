<?xml version="1.0" encoding="UTF-8"?>
<SXM xmlns="http://www.jsxm.org/schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="CoffeeMachine" xsi:schemaLocation="http://www.jsxm.org/schema http://www.jsxm.org/schema/specification.xsd">

  <states>
    <state name="poweredOff" />
    <state name="uninitialized" />
    <state name="idle" />
    <state name="creditAvailable" />
  </states>

  <initialState state="poweredOff"/>

  <transitions>
    <transition from="poweredOff" function="powerOn" to="uninitialized" />
    <transition from="poweredOff" function="powerOnIdle" to="idle" />
    <transition from="poweredOff" function="powerOnCreditAvailable" to="creditAvailable" />

    <transition from="uninitialized" function="powerOff" to="poweredOff" />
    <transition from="uninitialized" function="setPrice" to="idle" />

    <transition from="idle" function="powerOff" to="poweredOff" />
    <transition from="idle" function="setPrice" to="idle" />
    <transition from="idle" function="addCredit" to="creditAvailable" />

    <transition from="creditAvailable" function="powerOff" to="poweredOff" />
    <transition from="creditAvailable" function="setPrice" to="creditAvailable" />
    <transition from="creditAvailable" function="addCredit" to="creditAvailable" />
    <transition from="creditAvailable" function="buyCoffeeN" to="creditAvailable" />
    <transition from="creditAvailable" function="buyCoffee0" to="idle" />



    <transition from="poweredOff" function="powerOffAlreadyOff" to="poweredOff"/>
    <transition from="poweredOff" function="setPricePoweredOff" to="poweredOff"/>
    <transition from="poweredOff" function="addCreditPoweredOff" to="poweredOff"/>
    <transition from="poweredOff" function="buyCoffeePoweredOff" to="poweredOff"/>

    <transition from="uninitialized" function="powerOnAlreadyOn" to="uninitialized"/>
    <transition from="uninitialized" function="setPriceInvalidValue" to="uninitialized" />
    <transition from="uninitialized" function="addCreditPriceNotSet" to="uninitialized"/>
    <transition from="uninitialized" function="buyCoffeePriceNotSet" to="uninitialized"/>

    <transition from="idle" function="powerOnAlreadyOn" to="idle"/>
    <transition from="idle" function="setPriceInvalidValue" to="idle"/>
    <transition from="idle" function="addCreditPriceNotSet" to="uninitialized"/>
    <transition from="idle" function="addCreditInvalidValue" to="idle"/>
    <transition from="idle" function="buyCoffeePriceNotSet" to="uninitialized"/>
    <transition from="idle" function="buyCoffeeInvalidType" to="idle"/>
    <transition from="idle" function="buyCoffeeInsufficientCredit" to="idle"/>

    <transition from="creditAvailable" function="powerOnAlreadyOn" to="creditAvailable"/>
    <transition from="creditAvailable" function="setPriceInvalidValue" to="creditAvailable"/>
    <transition from="creditAvailable" function="addCreditPriceNotSet" to="uninitialized"/>
    <transition from="creditAvailable" function="addCreditInvalidValue" to="creditAvailable"/>
    <transition from="creditAvailable" function="buyCoffeePriceNotSet" to="uninitialized"/>
    <transition from="creditAvailable" function="buyCoffeeInvalidType" to="creditAvailable"/>
    <transition from="creditAvailable" function="buyCoffeeInsufficientCredit" to="creditAvailable"/>
  </transitions>

  <memory>
    <declaration> boolean isPoweredOn; int espressoPrice; int cappuccinoPrice; int credit; </declaration>
    <initial> isPoweredOn = false; espressoPrice = 0; cappuccinoPrice = 0; credit = 0; </initial>
    <display> "Machine is " + (isPoweredOn ? "ON" : "OFF") + ", Espresso Price: " + espressoPrice + ", Cappuccino Price: " + cappuccinoPrice + ", Credit: " + credit </display>
  </memory>

  <inputs>
    <input name="powerOn" />

    <input name="powerOff" />

    <input name="setPrice">
      <arg name="espressoPrice" type="xs:int" />
      <arg name="cappuccinoPrice" type="xs:int" />
    </input>

    <input name="addCredit">
      <arg name="amount" type="xs:int" />
    </input>

    <input name="buyCoffee">
      <arg name="coffeeType" type="xs:string" />
    </input>
  </inputs>

  <outputs>
    <output name="powerOnOut">
      <result name="isPoweredOn" type="xs:boolean" />
      <result name="message" type="xs:string" />
    </output>

    <output name="powerOffOut">
      <result name="isPoweredOn" type="xs:boolean"/>
      <result name="message" type="xs:string"/>
    </output>

    <output name="setPriceOut">
      <result name="newEspressoPrice" type="xs:int" />
      <result name="newCappuccinoPrice" type="xs:int" />
      <result name="message" type="xs:string"/>
    </output>

    <output name="addCreditOut">
      <result name="newCredit" type="xs:int" />
      <result name="message" type="xs:string"/>
    </output>

    <output name="buyCoffeeOut">
      <result name="coffeeTypeDispensed" type="xs:string" />
      <result name="remainingCredit" type="xs:int" />
      <result name="message" type="xs:string"/>
    </output>
  </outputs>

  <faults>
    <fault name="powerOnAlreadyOnError" />

    <fault name="powerOffAlreadyOffError" />

    <fault name="setPricePoweredOffError" />
    <fault name="setPriceInvalidValueError" />

    <fault name="addCreditPoweredOffError"/>
    <fault name="addCreditPriceNotSetError"/>
    <fault name="addCreditInvalidValueError" />

    <fault name="buyCoffeePoweredOffError"/>
    <fault name="buyCoffeePriceNotSetError" />
    <fault name="buyCoffeeInvalidTypeError" />
    <fault name="buyCoffeeInsufficientCreditError" />
  </faults>

  <functions>
    <function name="powerOn" input="powerOn" output="powerOnOut" xsi:type="OutputFunction">
        <precondition> ! isPoweredOn  &amp;&amp; espressoPrice == 0 &amp;&amp; cappuccinoPrice == 0 &amp;&amp; credit == 0 </precondition>
        <effect>
            isPoweredOn = true;
            powerOnOut.isPoweredOn = isPoweredOn;
            powerOnOut.message = "Coffee Machine powered ON";
        </effect>
    </function>

    <function name="powerOnIdle" input="powerOn" output="powerOnOut" xsi:type="OutputFunction">
        <precondition> ! isPoweredOn  &amp;&amp; ! (espressoPrice == 0 || cappuccinoPrice == 0) &amp;&amp; credit == 0 </precondition>
        <effect>
            isPoweredOn = true;
            powerOnOut.isPoweredOn = isPoweredOn;
            powerOnOut.message = "Coffee Machine powered ON";
        </effect>
    </function>

    <function name="powerOnCreditAvailable" input="powerOn" output="powerOnOut" xsi:type="OutputFunction">
        <precondition> ! isPoweredOn  &amp;&amp; ! (espressoPrice == 0 || cappuccinoPrice == 0) &amp;&amp; credit &gt; 0 </precondition>
        <effect>
            isPoweredOn = true;
            powerOnOut.isPoweredOn = isPoweredOn;
            powerOnOut.message = "Coffee Machine powered ON";
        </effect>
    </function>
    <function name="powerOff" input="powerOff" output="powerOffOut" xsi:type="OutputFunction">
        <precondition> isPoweredOn </precondition>
        <effect>
            isPoweredOn = false;
            powerOffOut.isPoweredOn = isPoweredOn;
            powerOffOut.message = "Coffee Machine powered OFF";
        </effect>
    </function>

    <function name="setPrice" input="setPrice" output="setPriceOut" xsi:type="OutputFunction">
      <precondition>
        setPrice.get_espressoPrice() &gt; 0 &amp;&amp;
        setPrice.get_cappuccinoPrice() &gt; 0
      </precondition>
      <effect>
        espressoPrice = setPrice.get_espressoPrice();
        cappuccinoPrice = setPrice.get_cappuccinoPrice();
        setPriceOut.newEspressoPrice = espressoPrice;
        setPriceOut.newCappuccinoPrice = cappuccinoPrice;
        setPriceOut.message = "Prices set: Espresso - " + espressoPrice + ", Cappuccino - " + cappuccinoPrice;
      </effect>
    </function>

    <function name="addCredit" input="addCredit" output="addCreditOut" xsi:type="OutputFunction">
      <precondition>
        isPoweredOn &amp;&amp;
        (addCredit.get_amount() == 1 || addCredit.get_amount() == 5 || addCredit.get_amount() == 10 || addCredit.get_amount() == 20)
      </precondition>
      <effect>
        credit += addCredit.get_amount();
        addCreditOut.newCredit = credit;
        addCreditOut.message = "Credit added: " + addCredit.get_amount() + ". Total credit: " + credit;
      </effect>
    </function>

    <function name="buyCoffeeN" input="buyCoffee" output="buyCoffeeOut" xsi:type="OutputFunction">
      <precondition>
        isPoweredOn &amp;&amp;
        (buyCoffee.get_coffeeType() == "espresso" || buyCoffee.get_coffeeType() == "cappuccino") &amp;&amp;
        credit > (buyCoffee.get_coffeeType() == "espresso" ? espressoPrice : cappuccinoPrice)
      </precondition>
      <effect>
        credit -= (buyCoffee.get_coffeeType() == "espresso" ? espressoPrice : cappuccinoPrice);
        buyCoffeeOut.coffeeTypeDispensed = buyCoffee.get_coffeeType();
        buyCoffeeOut.remainingCredit = credit;
        buyCoffeeOut.message = "Coffee dispensed: " + buyCoffeeOut.coffeeTypeDispensed + ". Remaining credit: " + buyCoffeeOut.remainingCredit;
      </effect>
    </function>

    <function name="buyCoffee0" input="buyCoffee" output="buyCoffeeOut" xsi:type="OutputFunction">
      <precondition>
        isPoweredOn &amp;&amp;
        (buyCoffee.get_coffeeType() == "espresso" || buyCoffee.get_coffeeType() == "cappuccino") &amp;&amp;
        credit == (buyCoffee.get_coffeeType() == "espresso" ? espressoPrice : cappuccinoPrice)
      </precondition>
      <effect>
        credit -= (buyCoffee.get_coffeeType() == "espresso" ? espressoPrice : cappuccinoPrice);
        buyCoffeeOut.coffeeTypeDispensed = buyCoffee.get_coffeeType();
        buyCoffeeOut.remainingCredit = credit;
        buyCoffeeOut.message = "Coffee dispensed: " + buyCoffeeOut.coffeeTypeDispensed + ". Remaining credit: " + buyCoffeeOut.remainingCredit;
      </effect>
    </function>



    <function name="powerOnAlreadyOn" input="powerOn" fault="powerOnAlreadyOnError" xsi:type="FaultFunction">
      <precondition> isPoweredOn </precondition>
    </function>

    <function name="powerOffAlreadyOff" input="powerOff" fault="powerOffAlreadyOffError" xsi:type="FaultFunction">
      <precondition> ! isPoweredOn </precondition>
    </function>

    <function name="setPricePoweredOff" input="setPrice" fault="setPricePoweredOffError" xsi:type="FaultFunction">
      <precondition> ! isPoweredOn </precondition>
    </function>

    <function name="setPriceInvalidValue" input="setPrice" fault="setPriceInvalidValueError" xsi:type="FaultFunction">
      <precondition> ! (setPrice.get_espressoPrice() &gt; 0 &amp;&amp; setPrice.get_cappuccinoPrice() &gt; 0) </precondition>
    </function>

    <function name="addCreditPoweredOff" input="addCredit" fault="addCreditPoweredOffError" xsi:type="FaultFunction">
      <precondition> ! isPoweredOn </precondition>
    </function>

    <function name="addCreditPriceNotSet" input="addCredit" fault="addCreditPriceNotSetError" xsi:type="FaultFunction">
      <precondition> espressoPrice == 0 &amp;&amp; cappuccinoPrice == 0 </precondition>
    </function>

    <function name="addCreditInvalidValue" input="addCredit" fault="addCreditInvalidValueError" xsi:type="FaultFunction">
      <precondition> ! (addCredit.get_amount() == 1 || addCredit.get_amount() == 5 || addCredit.get_amount() == 10 || addCredit.get_amount() == 20) </precondition>
    </function>

    <function name="buyCoffeePoweredOff" input="buyCoffee" fault="buyCoffeePoweredOffError" xsi:type="FaultFunction">
      <precondition> ! isPoweredOn </precondition>
    </function>

    <function name="buyCoffeePriceNotSet" input="buyCoffee" fault="buyCoffeePriceNotSetError" xsi:type="FaultFunction">
      <precondition> espressoPrice == 0 &amp;&amp; cappuccinoPrice == 0 </precondition>
    </function>

    <function name="buyCoffeeInvalidType" input="buyCoffee" fault="buyCoffeeInvalidTypeError" xsi:type="FaultFunction">
      <precondition> ! (buyCoffee.get_coffeeType() == "espresso" || buyCoffee.get_coffeeType() == "cappuccino") </precondition>
    </function>

    <function name="buyCoffeeInsufficientCredit" input="buyCoffee" fault="buyCoffeeInsufficientCreditError" xsi:type="FaultFunction">
      <precondition> (buyCoffee.get_coffeeType() == "espresso" || buyCoffee.get_coffeeType() == "cappuccino") &amp;&amp; credit &lt; (buyCoffee.get_coffeeType() == "espresso" ? espressoPrice : cappuccinoPrice) </precondition>
    </function>
  </functions>

  <!--Test Input Generation definition-->
  <testinputgeneration>
    <!--An inputgenerator uses a function and the function must be one
        of the available functions. A Stream X Machine can contain many input generators.
    -->
    <inputgenerator function="setPrice"> setPrice.set_espressoPrice(10); setPrice.set_cappuccinoPrice(15); </inputgenerator>
    <inputgenerator function="addCredit"> addCredit.set_amount(10); </inputgenerator>
    <inputgenerator function="buyCoffeeN"> buyCoffee.set_coffeeType("espresso"); </inputgenerator>
    <inputgenerator function="buyCoffee0"> buyCoffee.set_coffeeType("cappuccino"); </inputgenerator>
    
    <inputgenerator function="setPricePoweredOff"> setPrice.set_espressoPrice(10); setPrice.set_cappuccinoPrice(15); </inputgenerator>
    <inputgenerator function="setPriceInvalidValue"> setPrice.set_espressoPrice(0); setPrice.set_cappuccinoPrice(-5); </inputgenerator>
    <inputgenerator function="addCreditPoweredOff"> addCredit.set_amount(10); </inputgenerator>
    <inputgenerator function="addCreditPriceNotSet"> addCredit.set_amount(10); </inputgenerator>
    <inputgenerator function="addCreditInvalidValue"> addCredit.set_amount(3); </inputgenerator>
    <inputgenerator function="buyCoffeePoweredOff"> buyCoffee.set_coffeeType("espresso"); </inputgenerator>
    <inputgenerator function="buyCoffeePriceNotSet"> buyCoffee.set_coffeeType("cappuccino"); </inputgenerator>
    <inputgenerator function="buyCoffeeInvalidType"> buyCoffee.set_coffeeType("latte"); </inputgenerator>
    <inputgenerator function="buyCoffeeInsufficientCredit"> buyCoffee.set_coffeeType("espresso"); </inputgenerator>
  </testinputgeneration>
</SXM>