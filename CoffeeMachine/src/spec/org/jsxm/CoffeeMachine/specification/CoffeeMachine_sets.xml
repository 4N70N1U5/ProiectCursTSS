<?xml version="1.0" encoding="UTF-8"?>
<sets xmlns="http://www.jsxm.org/schema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.jsxm.org/schema http://www.jsxm.org/schema/sets.xsd">
  <!--Characterization definition-->
  <characterization>
    <sequence>
      <function name="powerOn" />
    </sequence>
    <sequence>
      <function name="setPrice" />
    </sequence>
    <sequence>
      <function name="addCredit" />
    </sequence>
  </characterization>
  <!--StateCover definition-->
  <statecover>
    <!--poweredOff-->
    <sequence />

    <!--poweredOff -> uninitialized-->
    <sequence>
      <function name="powerOn" />
    </sequence>

    <!--poweredOff -> uninitialized -> idle -->
    <sequence>
      <function name="powerOn" />
      <function name="setPrice" />
    </sequence>

    <!--poweredOff -> uninitialized -> idle -> creditAvailable-->
    <sequence>
      <function name="powerOn" />
      <function name="setPrice" />
      <function name="addCredit" />
    </sequence>
  </statecover>
</sets>

